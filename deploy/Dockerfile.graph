# syntax=docker/dockerfile:1.7
FROM ghcr.io/astral-sh/uv:0.12.3 AS uv

FROM python:3.13-slim AS builder
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project
COPY src ./src
RUN uv sync --frozen --no-dev

FROM python:3.13-slim AS runtime
RUN groupadd --gid 10001 m365 \
    && useradd --uid 10001 --gid 10001 --create-home --home-dir /home/m365 m365
ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    MCP_CONFIG_PATH=/app/config/enabledTools.json
WORKDIR /app
COPY --from=builder --chown=root:root /app/.venv /app/.venv
COPY --chown=root:root config /app/config
RUN chmod 755 /app/config \
    && chmod 644 /app/config/*.json
USER 10001:10001
EXPOSE 8000
ENTRYPOINT []
CMD ["m365-graph-server"]

FROM runtime AS agent
USER root
COPY --chown=root:root agent_smoke /app/agent_smoke
USER 10001:10001
ENTRYPOINT []
CMD ["python", "-m", "agent_smoke.smoke"]
