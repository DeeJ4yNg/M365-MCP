# Copy this file to .env and replace every placeholder.
# Never commit .env or the secrets/ directory.

M365_TENANT_ID=00000000-0000-0000-0000-000000000000
M365_ORGANIZATION=contoso.onmicrosoft.com
M365_SHAREPOINT_ADMIN_URL=https://contoso-admin.sharepoint.com

M365_GRAPH_CLIENT_ID=11111111-1111-1111-1111-111111111111
M365_POWERSHELL_CLIENT_ID=22222222-2222-2222-2222-222222222222

# Inbound MCP resource API and Agent app allow-list.
MCP_ENTRY_TENANT_ID=00000000-0000-0000-0000-000000000000
MCP_GRAPH_AUDIENCE=api://m365-graph-mcp
MCP_POWERSHELL_AUDIENCE=api://m365-powershell-mcp
MCP_ALLOWED_CLIENT_IDS=33333333-3333-3333-3333-333333333333
MCP_READ_ROLES=M365.MCP.Read,M365.MCP.ReadWrite
MCP_WRITE_ROLES=M365.MCP.ReadWrite

# Confirmation JWT issuer. The signing private key belongs to the approval system.
MCP_CONFIRMATION_ISSUER=m365-change-approval
MCP_CONFIRMATION_MAX_TTL_SECONDS=900

MCP_LOG_LEVEL=INFO
MCP_MAX_RESULT_BYTES=1000000
MCP_MAX_PAGES=5
MCP_REQUEST_TIMEOUT_SECONDS=30
M365_PS_MAX_CONCURRENCY=4
M365_PS_WORKER_TIMEOUT_SECONDS=120

# Hybrid action search. Set lexical to disable semantic retrieval.
MCP_SEARCH_MODE=hybrid
MCP_SEARCH_EMBEDDING_URL=http://dgx-spark:8081/v1/embeddings
MCP_SEARCH_EMBEDDING_API_KEY=
MCP_SEARCH_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
MCP_SEARCH_EMBEDDING_DIMENSION=1024
MCP_SEARCH_EMBEDDING_HEALTH_URL=http://dgx-spark:8081/health
MCP_SEARCH_QUERY_INSTRUCTION=Given a Microsoft 365 administration intent, retrieve the most relevant action.
MCP_SEARCH_QUERY_PREFIX=
MCP_SEARCH_PASSAGE_PREFIX=
MCP_SEARCH_BATCH_SIZE=32
MCP_SEARCH_TIMEOUT_SECONDS=10
MCP_SEARCH_SEMANTIC_WEIGHT=0.55
MCP_SEARCH_LEXICAL_WEIGHT=0.45
MCP_SEARCH_SEMANTIC_FLOOR=0.30
MCP_SEARCH_SEMANTIC_CEILING=0.95
MCP_SEARCH_MIN_SCORE=0.05
MCP_SEARCH_LEXICAL_SCALE=25
MCP_SEARCH_CACHE_SIZE=256
MCP_SEARCH_FALLBACK_TO_LEXICAL=false
MCP_SEARCH_VERIFY_RESPONSE_MODEL=false

# Bind only to loopback by default. Change deliberately if a reverse proxy fronts MCP.
GRAPH_MCP_PORT=8000
POWERSHELL_MCP_PORT=8001
GRAPH_MCP_ALLOWED_HOSTS=graph-mcp,localhost,127.0.0.1
POWERSHELL_MCP_ALLOWED_HOSTS=powershell-mcp,localhost,127.0.0.1

# Used only by `docker compose --profile smoke run --rm agent-smoke`.
# The Agent client ID is used by the host token script, not the MCP servers.
SMOKE_CLIENT_ID=33333333-3333-3333-3333-333333333333
SMOKE_CERTIFICATE_PATH=./secrets/agent.pfx
SMOKE_CERTIFICATE_PASSWORD_FILE=./secrets/agent.pfx.password

# Each token has a different audience. Never persist either token in this file.
SMOKE_GRAPH_ACCESS_TOKEN=
SMOKE_POWERSHELL_ACCESS_TOKEN=

# Optional comma-separated browser origins. Leave empty for server-to-server Agents.
MCP_ALLOWED_ORIGINS=
